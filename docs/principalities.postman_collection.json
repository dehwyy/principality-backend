{
  "info": {
    "name": "Княжества Древней Руси — веб-сервис",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Домен княжества",
      "item": [
        {
          "name": "Список княжеств с фильтром по дате основания",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/principalities?foundedBefore=1100-01-01",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "principalities"
              ],
              "query": [
                {
                  "key": "foundedBefore",
                  "value": "1100-01-01"
                }
              ]
            }
          }
        },
        {
          "name": "Добавление княжества с изображением и видео",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/principalities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "principalities"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "principality_name",
                  "value": "Новгородская земля",
                  "type": "text"
                },
                {
                  "key": "principality_image",
                  "type": "file",
                  "src": "novgorod.jpg"
                },
                {
                  "key": "principality_video",
                  "type": "file",
                  "src": "novgorod.mp4"
                }
              ]
            }
          }
        },
        {
          "name": "Черновик княжества текущего археолога",
          "request": {
            "method": "GET",
            "header": [],
