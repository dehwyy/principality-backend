              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "principalities",
                "draft"
              ]
            }
          }
        },
        {
          "name": "Публикация княжества",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
