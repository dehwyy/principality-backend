                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "principalities",
                "draft",
                "publish"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principality_summary\": \"Новгород на Волхове: Детинец на Софийской стороне и Торговая сторона с Ярославовым дворищем, в XIV веке обнесённые валом Окольного города. Мостовые и берестяные грамоты Неревского раскопа дают самую подробную картину усадебной застройки Руси.\",\n  \"founding_date\": \"1136-01-01\",\n  \"land_coefficient\": 0.55\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Лента княжеств (без ид и по ид ?next=true)",
