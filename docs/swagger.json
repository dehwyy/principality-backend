        "/api/principalities": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Опубликованные княжества с фильтром по дате основания; признак created_by_current_archaeologist для автора, гостю 0",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Княжества"
                ],
                "summary": "Список княжеств",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Основано до даты, ГГГГ-ММ-ДД",
                        "name": "foundedBefore",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ds.PrincipalityCatalogSerializer"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Создаёт черновик княжества с файлами изображения и видео в Minio; создатель берётся из JWT",
                "consumes": [
                    "multipart/form-data"
